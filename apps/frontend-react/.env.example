# Local development (copied to .env by mt5-platform.bat when missing)
VITE_API_BASE_URL=http://localhost:8000

# Optional websocket override (defaults to API_BASE with ws://)
# VITE_WS_BASE=http://localhost:8000

# Restore production API while the UI still runs on localhost:
# VITE_USE_PRODUCTION_API=true
#
# Hosted/production builds use `.env.production` (Windows EC2 HTTP API).
