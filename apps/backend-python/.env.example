APP_NAME=MT5 Platform API
ENVIRONMENT=development
DEBUG=true

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=mt5_platform

JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_SECRET=change-this-to-a-long-random-secret
PLATFORM_AUDIT_DB=mt5_platform
LOG_FORMAT=text
LOG_LEVEL=INFO
LOG_FILE=logs/backend.log
LOG_TO_CONSOLE=false
LOG_MAX_BYTES=20971520
LOG_BACKUP_COUNT=10
TRAP_HUNTER_LOG_LEVEL=DEBUG
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

FERNET_KEY=generate-with-python-command-in-readme

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://signalbridge.in,https://www.signalbridge.in,https://app.signalbridge.in,https://crypto.signalbridge.in,https://main.d3inecn5vye1xf.amplifyapp.com,http://ec2-13-232-110-145.ap-south-1.compute.amazonaws.com:5173,http://13.232.110.145:5173
CORS_ORIGIN_REGEX=https://([\w-]+\.)*signalbridge\.in|https://([\w-]+)\.amplifyapp\.com|http://ec2-\d+-\d+-\d+-\d+\.ap-south-1\.compute\.amazonaws\.com:5173|http://13\.232\.110\.145:5173
RATE_LIMIT_DEFAULT=120/minute

# Optional but recommended if multiple MT5 terminals are installed.
# Example: path to the terminal executable for the MT5 instance used by this account.
MT5_TERMINAL_PATH=
MT5_TIMEOUT_MS=60000
MT5_API_TIMEOUT_SECONDS=75
